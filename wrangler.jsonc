{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toyinog-website",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": { "enabled": true },
}
