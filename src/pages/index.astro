---
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import StatusDot from '../components/StatusDot.astro';
import Legend from '../components/Legend.astro';
import CaseCard from '../components/CaseCard.astro';
import HighlightCard from '../components/HighlightCard.astro';

const site = await getEntry('site', 'site');
if (!site) throw new Error('Missing site entry: src/content/site.yaml');
const { name, tagline, descriptor, availability, socials } = site.data;

const featured = (await getCollection('work', (e) => e.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

const highlights = (await getCollection('highlights'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
if (highlights.length < 3) {
  throw new Error('Home needs at least 3 highlights in src/content/highlights');
}
const highlightCards = await Promise.all(
  highlights.map(async (h) => ({
    ...h.data,
    thumbnail: (
      await getImage({ src: h.data.thumbnail, width: 640, height: 360 })
    ).src,
    date: h.data.date.toISOString().slice(0, 10),
  })),
);

const platformLabel = { youtube: 'YouTube', x: 'X', github: 'GitHub' } as const;
const socialLinks = [
  { label: 'X', href: socials.x },
  { label: 'GitHub', href: socials.github },
  { label: 'YouTube', href: socials.youtube },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title="toyinog.com" currentPath="/">
  <meta slot="head" name="description" content={tagline} />

  <section class="hero">
    <StatusDot label={availability} />
    <h1>{name}</h1>
    <p class="tagline">{tagline}</p>
    {descriptor && <p class="descriptor">{descriptor}</p>}
    <div class="actions">
      <Button href="/work">View work</Button>
      <a class="text-link" href="/contact">
        Contact
      </a>
    </div>
  </section>

  <section class="block" aria-labelledby="work-heading">
    <Legend>01 / WORK</Legend>
    <h2 id="work-heading">Selected work</h2>
    <div class="grid">
      {featured.map((entry, i) => (
        <CaseCard
          legend={`Project ${pad(i + 1)}`}
          title={entry.data.title}
          outcome={entry.data.summary}
          year={entry.data.year}
          href={`/work/${entry.id}`}
        />
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="highlights-heading">
    <Legend>02 / HIGHLIGHTS</Legend>
    <h2 id="highlights-heading">Highlights</h2>
    <div class="grid">
      {highlightCards.map((h) => (
        <HighlightCard
          title={h.title}
          platform={platformLabel[h.platform]}
          url={h.url}
          thumbnail={h.thumbnail}
          date={h.date}
        />
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="elsewhere-heading">
    <Legend>03 / ELSEWHERE</Legend>
    <h2 id="elsewhere-heading">Find me</h2>
    <ul class="socials">
      {socialLinks.map((s) => (
        <li>
          <a href={s.href} rel="noopener noreferrer">
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-md);
  }

  .tagline {
    font-family: var(--font-voice);
    font-weight: 700;
    font-size: var(--type-headline-md-font-size);
    line-height: var(--type-headline-md-line-height);
    max-width: 30ch;
  }

  .descriptor {
    font-size: var(--type-body-lg-font-size);
    line-height: var(--type-body-lg-line-height);
    color: var(--color-secondary);
    max-width: 60ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-md) var(--spacing-lg);
    margin-top: var(--spacing-lg);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-on-surface);
    text-decoration-color: var(--color-primary);
  }

  .text-link:hover {
    color: var(--color-on-surface);
    text-decoration-color: var(--color-tertiary);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xxl, 128px);
  }

  .grid {
    display: grid;
    gap: var(--spacing-gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
