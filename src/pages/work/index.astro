---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Legend from '../../components/Legend.astro';
import CaseRow from '../../components/CaseRow.astro';

const entries = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Work | toyinog.com"
  description="Case studies: the problem, the decision and the outcome."
  currentPath="/work"
>
  <header class="head">
    <Legend>WORK</Legend>
    <h1>Work</h1>
    <p>Case studies: the problem, the decision and the outcome.</p>
  </header>

  <ol class="rows" aria-label="Case studies">
    {entries.map((entry, i) => (
      <CaseRow
        index={pad(i + 1)}
        title={entry.data.title}
        outcome={entry.data.outcome}
        year={entry.data.year}
        stack={entry.data.stack}
        href={`/work/${entry.id}`}
      />
    ))}
  </ol>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  h1 {
    font-size: var(--type-headline-lg-font-size);
    line-height: var(--type-headline-lg-line-height);
  }

  .rows {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
</style>
