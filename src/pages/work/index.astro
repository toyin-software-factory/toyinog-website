---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Legend from '../../components/Legend.astro';
import CaseCard from '../../components/CaseCard.astro';

const entries = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Work | toyinog.com"
  description="Case studies: the problem, the decision and the outcome."
  currentPath="/work"
>
  <header class="head">
    <Legend>WORK</Legend>
    <h1>Work</h1>
    <p>Case studies: the problem, the decision and the outcome.</p>
  </header>

  <div class="grid">
    {entries.map((entry, i) => (
      <CaseCard
        legend={`Project ${pad(i + 1)}`}
        title={entry.data.title}
        outcome={entry.data.summary}
        year={entry.data.year}
        href={`/work/${entry.id}`}
      />
    ))}
  </div>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  h1 {
    font-size: var(--type-headline-lg-font-size);
    line-height: var(--type-headline-lg-line-height);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--spacing-gutter);
  }
</style>
