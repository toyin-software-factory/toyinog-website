---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
const contact = { href: '/contact', label: 'Contact' };

const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="inner">
    <a
      class="brand"
      href="/"
      aria-current={currentPath === '/' ? 'page' : undefined}
    >
      toyinog.com
    </a>
    <nav aria-label="Primary">
      <ul>
        {[...links, contact].map((link) => (
          <li class={link === contact ? 'contact' : undefined}>
            <a
              href={link.href}
              class={isCurrent(link.href) ? 'is-current' : undefined}
              aria-current={
                currentPath === link.href || currentPath === `${link.href}/`
                  ? 'page'
                  : undefined
              }
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm) var(--spacing-lg);
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--spacing-md);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  nav {
    flex: 1;
  }

  nav ul {
    width: 100%;
  }

  /* Contact sits at the right edge, set apart from Work/About, not lit. */
  .contact {
    margin-left: auto;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--type-label-caps-font-size);
    letter-spacing: var(--type-label-caps-letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-on-surface);
    border-bottom: 1px solid transparent;
  }

  a:hover {
    color: var(--color-on-surface);
  }

  /* Current page is marked with an underline and bold, not the accent colour. */
  a[aria-current='page'],
  a.is-current {
    font-weight: 700;
    border-bottom-color: var(--color-primary);
  }

  .brand {
    font-family: var(--font-voice);
    font-size: var(--type-headline-sm-font-size);
    letter-spacing: 0;
    text-transform: none;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .inner {
      flex-wrap: nowrap;
      gap: var(--spacing-md);
    }

    nav ul {
      flex-wrap: nowrap;
      gap: var(--spacing-md);
    }
  }

  @media (min-width: 960px) {
    .inner {
      padding-inline: var(--spacing-margin);
    }
  }
</style>
