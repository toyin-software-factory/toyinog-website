---
import Legend from './Legend.astro';

const year = new Date().getFullYear();
const links = [
  { href: 'https://x.com/mastarhtee', label: 'X' },
  { href: 'https://github.com/toyinogun', label: 'GitHub' },
];
---

<footer class="site-footer">
  <div class="inner">
    <Legend>
      © <span class="num">{year}</span> Toyin
    </Legend>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm) var(--spacing-lg);
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--spacing-lg) var(--spacing-md);
  }

  ul {
    display: flex;
    gap: var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--type-label-caps-font-size);
    letter-spacing: var(--type-label-caps-letter-spacing);
    text-transform: uppercase;
  }

  @media (min-width: 960px) {
    .inner {
      padding-inline: var(--spacing-margin);
    }
  }
</style>
