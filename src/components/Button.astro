---
interface Props {
  /** Primary is the one lit control per viewport; secondary stays unlit. */
  variant?: 'primary' | 'secondary';
  /** Renders a link when set, otherwise a button. */
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  disabled = false,
} = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['button', variant]}
  href={disabled ? undefined : href}
  role={href && disabled ? 'link' : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid transparent;
    border-radius: var(--rounded-sm);
    font-family: var(--font-apparatus);
    font-size: var(--type-label-caps-font-size);
    line-height: var(--type-label-caps-line-height);
    letter-spacing: var(--type-label-caps-letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color var(--motion-color-duration),
      background-color var(--motion-color-duration),
      border-color var(--motion-color-duration);
  }

  .primary {
    background-color: var(--color-tertiary);
    color: var(--color-surface);
    font-weight: 700;
  }

  .primary:hover {
    background-color: var(--color-tertiary-strong);
    color: var(--color-surface);
  }

  .secondary {
    background-color: var(--color-surface);
    color: var(--color-on-surface);
    border-color: var(--color-primary);
  }

  .secondary:hover {
    color: var(--color-on-surface);
    border-color: var(--color-tertiary);
  }

  .button:disabled,
  .button[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
